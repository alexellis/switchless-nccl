# Copy this file once per node and replace every placeholder.
FABRIC0_IF=enp1s0f0np0
FABRIC0_MAC=00:00:00:00:00:00
FABRIC0_ADDRESS=10.20.10.1/24

FABRIC1_IF=enp1s0f1np1
FABRIC1_MAC=00:00:00:00:00:01
FABRIC1_ADDRESS=10.20.40.1/24

# The script writes only this file. Do not point it at an existing broad site
# configuration containing the management interface.
NETPLAN_FILE=/etc/netplan/90-switchless-fabric.yaml
